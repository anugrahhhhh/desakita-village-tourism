# Copy to .env (git-ignored) and adjust.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres@localhost:5432/desakita?sslmode=disable
UPLOAD_DIR=./data/uploads
BOOKING_PENDING_TTL=48h
APP_TIMEZONE=Asia/Jakarta
# Set to true only behind a reverse proxy that sets X-Forwarded-For/X-Real-IP (Fly, Railway, nginx).
TRUST_PROXY=false
# debug, info, warn or error
LOG_LEVEL=info

# Public origin for links in emails.
APP_BASE_URL=http://localhost:8080
MAIL_FROM=DesaKita <noreply@desakita.local>
# Without SMTP_HOST, emails are written as .eml files to MAIL_DIR (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), tls (465) or none (local Mailpit only)
SMTP_TLS=starttls
MAIL_DIR=./data/mail

# Integration tests clone databases on this server (user needs CREATEDB).
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres?sslmode=disable
