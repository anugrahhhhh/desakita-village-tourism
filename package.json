{
  "name": "desakita-assets",
  "private": true,
  "scripts": {
    "build:css": "node -e \"require('fs').mkdirSync('web/static',{recursive:true})\" && tailwindcss -i web/assets/app.css -o web/static/app.css --minify",
    "watch:css": "tailwindcss -i web/assets/app.css -o web/static/app.css --watch",
    "vendor:htmx": "node -e \"require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','web/static/htmx.min.js')\"",
    "vendor:assets": "node scripts/vendor-assets.mjs"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "5.2.5",
    "@tailwindcss/cli": "4.1.11",
    "htmx.org": "2.0.4",
    "lucide-static": "0.469.0",
    "tailwindcss": "4.1.11"
  }
}
